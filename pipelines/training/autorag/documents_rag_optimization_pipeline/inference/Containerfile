# This container is used for deploying AutoRAG-generated agents for inference
# (odh-autorag-inference). Pattern-agnostic: the selected pattern is supplied
# at deployment time via AGENT_CONFIG_B64.

ARG BASE_IMAGE=quay.io/aipcc/base-images/cpu-torch2.13-el9.8:1793124049

FROM ${BASE_IMAGE}

COPY pipelines/training/autorag/documents_rag_optimization_pipeline/inference/requirements.txt /tmp/

## TODO: Ensure build isolation
RUN pip install --no-cache-dir -r /tmp/requirements.txt && pip check

# Application payload from the starter-kit template (no placeholders in these
# files; per-pattern files like agent_config.json are NOT baked in).
COPY --chown=1001:0 \
    components/training/autorag/shared/assets_generator/starter_kit_templates/agentic_rag/main.py \
    components/training/autorag/shared/assets_generator/starter_kit_templates/agentic_rag/auth_wrapper.py \
    /opt/app-root/inference/
COPY --chown=1001:0 \
    components/training/autorag/shared/assets_generator/starter_kit_templates/agentic_rag/src/ \
    /opt/app-root/inference/src/

WORKDIR /opt/app-root/inference
ENV PYTHONPATH=/opt/app-root/inference/src
ENV PORT=8080
EXPOSE 8080

# auth_wrapper requires K8S_API_URL, K8S_REVIEWER_TOKEN (and optionally
# K8S_CA_PATH, defaulting to the pod ServiceAccount CA) at startup.
CMD ["uvicorn", "auth_wrapper:app", "--host", "0.0.0.0", "--port", "8080"]
