# This container is used to run the AutoRAG components of the training pipeline.

ARG BASE_IMAGE="quay.io/aipcc/base-images/cpu:3.4"

# skopeo for --oci fallback (aipcc base has no DNF repos to install packages).
FROM quay.io/skopeo/stable AS skopeo-bin

FROM ${BASE_IMAGE}
COPY --from=skopeo-bin /usr/bin/skopeo /usr/bin/skopeo

# Build context must be this directory (see .tekton/odh-autorag-ci-* path-context).
COPY requirements.txt requirements-pypi.txt requirements-pypi-whl.txt /tmp/
COPY seed_docling_models.py artifacts.lock.yaml install_sqlite_from_source.sh /tmp/

# Build SQLite from sqlite-autoconf (Hermeto generic prefetch or download); replace system libsqlite3.
# https://github.com/hermetoproject/hermeto/blob/main/docs/generic.md
ARG HERMETO_GENERIC_DEPS=/cachi2/output/deps/generic

# Build SQLite from sqlite-autoconf (Hermeto generic prefetch or download); replace system libsqlite3.
USER root
RUN HERMETO_GENERIC_DEPS="${HERMETO_GENERIC_DEPS}" bash /tmp/install_sqlite_from_source.sh
USER default

## TODO: Ensure build isolation
RUN pip install --index-url https://console.redhat.com/api/pypi/public-rhai/rhoai/3.4/cpu-ubi9/simple --no-cache-dir -r /tmp/requirements.txt
RUN pip install --index-url https://pypi.org/simple --no-cache-dir -r /tmp/requirements-pypi.txt
RUN pip install --index-url https://pypi.org/simple --no-cache-dir -r /tmp/requirements-pypi-whl.txt

# Docling models for offline text extraction from Red Hat OCI artifacts (RHAISTRAT-1710).
# Konflux: Hermeto prefetches registry.stage.redhat.io blobs via artifacts.lock.yaml into ${HERMETO_GENERIC_DEPS}.
# Local build: pull OCI artifacts via registry API (--oci) when Hermeto output is absent.
ENV DOCLING_ARTIFACTS_PATH=/opt/app-root/docling-artifacts/models
USER root
RUN mkdir -p /opt/app-root/docling-artifacts \
    && if find "${HERMETO_GENERIC_DEPS}" -path '*/docling-project--docling-layout-heron/config.json' -print -quit 2>/dev/null | grep -q .; then \
      python3 /tmp/seed_docling_models.py --dest /opt/app-root/docling-artifacts/models --hermeto-dir "${HERMETO_GENERIC_DEPS}"; \
    else \
      python3 /tmp/seed_docling_models.py --dest /opt/app-root/docling-artifacts/models --oci; \
    fi \
    && chown -R 1001:0 /opt/app-root/docling-artifacts
USER default
