# This container is used to run the AutoRAG components of the training pipeline.

ARG DOCLING_OGX_MODELCAR="registry.redhat.io/rhai/modelcar-redhatai-ogx-distribution:3.0@sha256:63f710736cbd083ffeeb8bd90686727c63cc5ab8be373dcf1b202a5411909d77"
ARG WHISPER_MODELCAR="registry.redhat.io/rhai/modelcar-redhatai-whisper-tiny:3.0"
ARG BASE_IMAGE="quay.io/aipcc/base-images/cpu-el9.8:3.6.0"
# Source of the CUDA 13 userspace runtime (see COPY below). Red Hat does not publish
# the CUDA runtime as pip wheels, so the locked GPU wheels get it from this image.
ARG CUDA_RUNTIME_IMAGE="quay.io/opendatahub/odh-base-image-cuda-py312-c9s:v13.0@sha256:6f8fcdd89279fd7217a53a76b912ff5a563600aff0d16faba15caa8f14600cd7"

FROM ${DOCLING_OGX_MODELCAR} AS docling-ogx-modelcar
FROM ${WHISPER_MODELCAR} AS whisper-modelcar
FROM ${CUDA_RUNTIME_IMAGE} AS cuda-runtime
FROM ${BASE_IMAGE}

# Copy the CUDA 13 userspace runtime out of the Red Hat CUDA image so the locked GPU
# wheels (torch/torchvision/onnxruntime-gpu/triton) link against it, while the final
# image keeps the required CPU base image. Both are OCI build inputs, so the build
# stays hermetic (no network). The toolkit libs (libcudart/libcublas/libcufft/...) go
# under the CUDA path; cuDNN 9, NCCL and cuSPARSELt live in the system lib dir.
# ldconfig puts them on the loader path so torch's global-deps load finds libcudart.so.13.
USER root
# Copy only the fully-versioned library files (two or more version segments); the
# SONAME symlinks (libcudnn.so.9, ...) are regenerated by ldconfig. Copying the
# symlinks via glob would dereference them into duplicate multi-GB files.
COPY --from=cuda-runtime /usr/local/cuda-13.0/targets/x86_64-linux/lib/ /usr/local/cuda-13.0/targets/x86_64-linux/lib/
COPY --from=cuda-runtime /usr/lib64/libcudnn*.so.*.* /usr/lib64/
COPY --from=cuda-runtime /usr/lib64/libnccl.so.*.* /usr/lib64/
COPY --from=cuda-runtime /usr/lib64/libcusparseLt.so.*.* /usr/lib64/
RUN printf '%s\n' /usr/local/cuda-13.0/targets/x86_64-linux/lib > /etc/ld.so.conf.d/cuda-13.conf && \
    ldconfig
USER default

COPY pipelines/training/autorag/documents_rag_optimization_pipeline/requirements.txt /tmp/

## TODO: Ensure build isolation
# Remove CPU runtime packages from the base image before installing the locked
# CUDA wheels. The build container has no GPU, so verify compiled CUDA support
# rather than checking torch.cuda.is_available().
RUN pip uninstall -y torch torchvision onnxruntime && \
    pip install --no-cache-dir -r /tmp/requirements.txt && \
    python -c 'import torch, torchvision, onnxruntime as ort; assert torch.version.cuda == "13.0", torch.version.cuda; assert "CUDAExecutionProvider" in ort.get_available_providers(), ort.get_available_providers(); print(torch.__version__, torchvision.__version__, ort.get_available_providers())'

# Temporary workaround for docling-core versions that reject the MIME type
# emitted by Docling's M4A ASR path. Remove when the upstream fix is available.
RUN ORIGIN_FILE="$(python -c 'import inspect; from docling_core.types.doc.common.origin import DocumentOrigin; print(inspect.getfile(DocumentOrigin))')" && \
    sed -i '/"audio\/mp3",/a\
        "audio/m4a",\
        "audio/mp4",' "$ORIGIN_FILE" && \
    python -c 'from docling_core.types.doc import DocumentOrigin; DocumentOrigin(filename="test.m4a", mimetype="audio/m4a", binary_hash=0); print("M4A MIME workaround enabled")'

# Docling models for offline text extraction (RHAI OGX modelcar). Its /models/docling/models/
# is already Docling's artifacts layout (docling-project--*/ plus RapidOcr/), so it is copied
# wholesale. ai4rag resolves OCR models relative to $DOCLING_ARTIFACTS_PATH/RapidOcr/ and
# raises FileNotFoundError when they are absent.
# Must match DOCLING_ARTIFACTS_PATH. Do not use /opt/docling-artifacts on aipcc: non-root RUN cannot mkdir there.
ENV DOCLING_ARTIFACTS_PATH=/opt/app-root/docling-artifacts/models
USER root
RUN mkdir -p /opt/app-root/docling-artifacts/models
COPY --from=docling-ogx-modelcar \
     /models/docling/models/ \
     /opt/app-root/docling-artifacts/models/
COPY --from=whisper-modelcar \
     /models/ \
     /opt/app-root/docling-artifacts/models/
RUN chown -R 1001:0 /opt/app-root/docling-artifacts && \
    chmod -R g+rw /opt/app-root/docling-artifacts
USER default
